{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizmaster.local/schemas/phrases.schema.json",
  "title": "en-te-hi-phrases.json",
  "description": "Everyday phrases, discourse markers and functional expressions. `register` and the optional `formalEquivalent` let this one file feed both Phrase Learning and Formal vs Informal English.",
  "type": "object",
  "required": ["schemaVersion", "fileType", "languages", "idPrefix", "generators", "entries"],
  "additionalProperties": false,
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "fileType": { "const": "phrases" },
    "languages": { "type": "array" },
    "updated": { "type": "string" },
    "description": { "type": "string" },
    "idPrefix": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/generatorSpec" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },

  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "classes", "phrase", "phraseType", "register", "meaning", "tags", "categoryHint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "classes": { "$ref": "common.schema.json#/$defs/classList" },
        "phrase": {
          "description": "`en` is the phrase taught. `te` and `hi` are what a speaker of that language would actually say in the same situation.",
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "phraseType": {
          "enum": ["idiom", "collocation", "discourse-marker", "functional", "greeting"]
        },
        "register": { "$ref": "common.schema.json#/$defs/register" },
        "meaning": { "$ref": "common.schema.json#/$defs/localizedText" },
        "example": { "$ref": "common.schema.json#/$defs/localizedText" },
        "situation": {
          "description": "Optional. When and where the phrase is used — the stem of a Situational English generator.",
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "formalEquivalent": {
          "description": "Optional. A more formal way of saying the same thing. All three languages hold the English string, because the drill compares two English registers.",
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "categoryHint": { "$ref": "common.schema.json#/$defs/category" }
      }
    }
  }
}
