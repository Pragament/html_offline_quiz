  "description": "Class-tagged opposite-word sets. The true-false generator uses `falseStatement` to emit a deliberately wrong pairing half the time.",
  "idPrefix": "gen-ant",
  "generators": [
    {
      "id": "pick-antonym-mcq",
      "questionType": "mcq",
      "category": "Vocabulary Building",
      "addTags": ["generated", "antonyms"],
      "weight": 2,
      "prompt": {
        "en": "Which word is the opposite of \"{{headword.en}}\"?",
        "te": "\"{{headword.en}}\" కు వ్యతిరేక పదం ఏది?",
        "hi": "\"{{headword.en}}\" का विलोम शब्द कौन सा है?"
      },
      "answer": { "path": "antonyms", "pick": "random" },
      "distractors": { "count": 3, "from": { "path": "headword" }, "scope": "siblings", "pool": "same-class", "poolFallback": "widen" },
      "explanation": {
        "en": "\"{{headword.en}}\" and \"{{answer}}\" describe opposite ends of the same idea.",
        "te": "\"{{headword.en}}\", \"{{answer}}\" ఒకే భావనకు రెండు వ్యతిరేక కొనలను సూచిస్తాయి.",
        "hi": "\"{{headword.en}}\" और \"{{answer}}\" एक ही विचार के दो विपरीत छोर बताते हैं।"
      }
    },
    {
      "id": "antonym-true-false",
      "questionType": "true-false",
      "category": "Vocabulary Building",
      "addTags": ["generated", "antonyms", "quick-check"],
      "prompt": {
        "en": "\"{{answer}}\" is the opposite of \"{{headword.en}}\".",
        "te": "\"{{answer}}\" అనేది \"{{headword.en}}\" కు వ్యతిరేక పదం.",
        "hi": "\"{{answer}}\" शब्द \"{{headword.en}}\" का विलोम है।"
      },
      "answer": { "path": "antonyms", "pick": "random" },
      "falseStatement": {
        "en": "\"{{headword.en}}\" is the opposite of \"{{headword.en}}\".",
        "te": "\"{{headword.en}}\" అనేది \"{{headword.en}}\" కు వ్యతిరేక పదం.",
        "hi": "\"{{headword.en}}\" शब्द \"{{headword.en}}\" का विलोम है।"
      }
    }
  ],
