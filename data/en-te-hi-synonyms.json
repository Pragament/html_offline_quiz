    {
      "id": "pick-synonym-mcq",
      "questionType": "mcq",
      "category": "Vocabulary Building",
      "addTags": ["generated", "synonyms"],
      "weight": 2,
      "prompt": {
        "en": "Which word means almost the same as \"{{headword.en}}\"?",
        "te": "\"{{headword.en}}\" అనే పదానికి దాదాపు అదే అర్థం ఇచ్చే పదం ఏది?",
        "hi": "\"{{headword.en}}\" के लगभग समान अर्थ वाला शब्द कौन सा है?"
      },
      "answer": { "path": "synonyms", "pick": "random" },
      "distractors": { "count": 3, "from": { "path": "headword" }, "scope": "siblings", "pool": "same-class", "poolFallback": "widen" },
      "explanation": {
        "en": "\"{{headword.en}}\" and \"{{answer}}\" can replace each other in most sentences.",
        "te": "\"{{headword.en}}\", \"{{answer}}\" చాలా వాక్యాలలో ఒకదాని స్థానంలో మరొకటి వాడవచ్చు.",
        "hi": "\"{{headword.en}}\" और \"{{answer}}\" अधिकांश वाक्यों में एक-दूसरे की जगह ले सकते हैं।"
      }
    },
    {
      "id": "synonym-flip",
      "questionType": "flip-card",
      "category": "Vocabulary Building",
      "addTags": ["generated", "synonyms", "recall"],
      "prompt": {
        "en": "Recall a synonym for \"{{headword.en}}\".",
        "te": "\"{{headword.en}}\" కు ఒక పర్యాయపదం గుర్తుచేసుకోండి.",
        "hi": "\"{{headword.en}}\" का एक पर्यायवाची याद कीजिए।"
      },
      "answer": { "path": "synonyms", "pick": "first" },
      "distractors": { "count": 3, "from": { "path": "headword" }, "scope": "siblings", "pool": "same-class", "poolFallback": "widen" }
    }
  ],
