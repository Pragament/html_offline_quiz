              "tip": {
                "en": "-mb at the end: the b is silent — comb, thumb, climb, lamb.",
                "te": "పదాంతంలో -mb: b ను పలకరు — comb, thumb, climb, lamb.",
                "hi": "अंत में -mb: b मौन रहता है — comb, thumb, climb, lamb।"
              }
            },
            {
              "tip": {
                "en": "wr- : the w is silent — write, wrong, wrist.",
                "te": "wr- : w ను పలకరు — write, wrong, wrist.",
                "hi": "wr- : w मौन रहता है — write, wrong, wrist।"
              }
            },
