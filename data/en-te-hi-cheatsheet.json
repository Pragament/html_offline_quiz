          "quizLink": { "category": "Error Correction", "tags": ["advanced", "agreement"] },
          "items": [
            {
              "id": "c8-err-1",
              "rule": {
                "en": "\"Neither\", \"either\", \"each\" and \"every\" take a singular verb.",
                "te": "\"Neither\", \"either\", \"each\", \"every\" లతో ఏకవచన క్రియ వస్తుంది.",
                "hi": "\"Neither\", \"either\", \"each\", \"every\" के साथ एकवचन क्रिया आती है।"
              },
              "examples": [
                { "en": "Each of the girls has a badge.", "te": "Each of the girls has a badge.", "hi": "Each of the girls has a badge." }
              ]
            },
            {
              "id": "c8-err-2",
              "rule": {
                "en": "After \"did\", \"does\" and \"do\", the main verb stays in its base form.",
                "te": "\"did\", \"does\", \"do\" తర్వాత ప్రధాన క్రియ మూల రూపంలోనే ఉంటుంది.",
                "hi": "\"did\", \"does\", \"do\" के बाद मुख्य क्रिया मूल रूप में रहती है।"
              },
              "examples": [
                { "en": "Where did you go? (not: Where did you went?)", "te": "Where did you go? (not: Where did you went?)", "hi": "Where did you go? (not: Where did you went?)" }
              ]
            },
            {
              "id": "c8-err-3",
              "rule": {
                "en": "\"Since\" marks a point in time; \"for\" marks a length of time.",
                "te": "\"Since\" ఒక కాల బిందువును, \"for\" కాల వ్యవధిని సూచిస్తుంది.",
                "hi": "\"Since\" समय का एक बिंदु बताता है; \"for\" समय की अवधि बताता है।"
              },
              "examples": [
                { "en": "since 2019 / for three years", "te": "since 2019 / for three years", "hi": "since 2019 / for three years" }
              ]
            }
          ]
        },
